@inject IOptions<DemoOptions> Demo

<aside class="sidebar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <div>
            <div class="brand-name">Northstar</div>
            <div class="brand-sub">Chat with Data</div>
        </div>
    </div>

    <ModeBadge />

    <nav class="nav">
        <NavLink href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg>
            Chat with Data
        </NavLink>
        <NavLink href="metrics">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 10h16M4 15h10M4 20h7"/></svg>
            Metric Catalog
        </NavLink>
        <NavLink href="inspector">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5M8 11h6M11 8v6"/></svg>
            Query Inspector
        </NavLink>
        <NavLink href="reconciliation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h4V8H4zM10 18h4V4h-4zM16 18h4v-7h-4z"/><path d="M3 21h18"/></svg>
            Data Reconciliation
        </NavLink>
        <NavLink href="architecture">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="6" rx="1.5"/><rect x="14" y="3" width="7" height="6" rx="1.5"/><rect x="8.5" y="15" width="7" height="6" rx="1.5"/><path d="M6.5 9v3h11V9M12 12v3"/></svg>
            Architecture
        </NavLink>
        <NavLink href="health">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg>
            System Health
        </NavLink>
        <NavLink href="scenarios">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8"/></svg>
            Example Scenarios
        </NavLink>
    </nav>

    <div class="sidebar-foot">
        Northstar Distribution · Northstar Bikes · Northstar Parts · Northstar Services<br />
        Execution mode: <strong>@Demo.Value.ExecutionMode</strong>
    </div>
</aside>
