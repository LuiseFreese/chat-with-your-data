# Configuration template for Connected Mode – copy values into ASP.NET Core user-secrets or environment variables
# (ASP.NET Core maps Section__Key). Local Demo Mode needs NONE of these settings.
# Never commit real values: .env is gitignored, secrets belong in `dotnet user-secrets`.

# --- Execution mode -------------------------------------------------------------------------
Demo__Mode=LocalDemo                 # LocalDemo | Connected
Demo__IntentParser=AzureOpenAI       # AzureOpenAI | Deterministic (Connected mode only; LocalDemo is always Deterministic)
Demo__DataSeed=20260325              # deterministic synthetic dataset seed

# --- Microsoft Fabric (Connected mode) -------------------------------------------------------
Fabric__WorkspaceId=<your-fabric-workspace-id>
Fabric__GovernedSemanticModelId=<id printed by: dotnet run --project tools/Northstar.Fabric.Tool -- deploy-model>
Fabric__GovernedSemanticModelName=CWD-GovernedModel
Fabric__PowerBiApiBaseUrl=https://api.powerbi.com/v1.0/myorg/
Fabric__Scopes__0=https://analysis.windows.net/powerbi/api/Dataset.Read.All

# --- Azure OpenAI (Connected mode, Entra auth via DefaultAzureCredential; ApiKey optional) ----
AzureOpenAI__Endpoint=https://<your-azure-openai-resource>.cognitiveservices.azure.com/
AzureOpenAI__Deployment=<your-chat-model-deployment-name>
AzureOpenAI__ApiKey=
AzureOpenAI__TimeoutSeconds=20

# --- Microsoft Entra ID (Connected mode) – store the secret in `dotnet user-secrets`, never here ---
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=<your-tenant-id>
AzureAd__ClientId=<your-app-registration-client-id>
AzureAd__ClientSecret=<set via: dotnet user-secrets set "AzureAd:ClientSecret" "<secret>" --project src/Northstar.Web>
AzureAd__CallbackPath=/signin-oidc

# --- Provisioning tool (tools/Northstar.Fabric.Tool) -----------------------------------------
NORTHSTAR_WORKSPACE_ID=<your-fabric-workspace-id>
NORTHSTAR_WAREHOUSE_ID=<printed by: dotnet run --project tools/Northstar.Fabric.Tool -- create-warehouse>
NORTHSTAR_WAREHOUSE_NAME=CWD-Warehouse
NORTHSTAR_SQL_ENDPOINT=<your-warehouse-sql-endpoint>.datawarehouse.fabric.microsoft.com
NORTHSTAR_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.cognitiveservices.azure.com/
NORTHSTAR_OPENAI_DEPLOYMENT=<your-chat-model-deployment-name>
# Test users for row-level security (optional; UPNs in YOUR tenant, format upn=Region1|Region2;…)
NORTHSTAR_RLS_USERS=<viewer.user@yourtenant.example=West;manager.user@yourtenant.example=North|South>
