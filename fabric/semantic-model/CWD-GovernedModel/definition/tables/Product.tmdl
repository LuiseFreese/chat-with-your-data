table Product
	sourceLineageTag: [cwd].[DimProduct]

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey
		sourceLineageTag: ProductKey
		isHidden

	column 'Product Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Product Name
		sourceLineageTag: Product Name

	/// Product category
	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category
		sourceLineageTag: Category

	column 'Business Unit'
		dataType: string
		summarizeBy: none
		sourceColumn: Business Unit
		sourceLineageTag: Business Unit
		isHidden

	column 'List Price'
		dataType: double
		sourceColumn: List Price
		sourceLineageTag: List Price
		formatString: #,##0.00 €
		summarizeBy: none

	partition Product = entity
		mode: directLake
		source
			entityName: DimProduct
			schemaName: cwd
			expressionSource: DatabaseQuery

