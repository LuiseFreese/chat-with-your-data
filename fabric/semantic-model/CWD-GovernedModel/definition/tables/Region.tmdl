/// Sales regions. Row-level security is applied on this table.
table Region
	sourceLineageTag: [cwd].[DimRegion]

	column RegionKey
		dataType: int64
		summarizeBy: none
		sourceColumn: RegionKey
		sourceLineageTag: RegionKey
		isHidden

	/// Sales region of the customer
	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region
		sourceLineageTag: Region

	partition Region = entity
		mode: directLake
		source
			entityName: DimRegion
			schemaName: cwd
			expressionSource: DatabaseQuery

