/// Credit notes for returned goods (grain: order).
table Returns
	sourceLineageTag: [cwd].[FactReturn]

	column ReturnKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ReturnKey
		sourceLineageTag: ReturnKey
		isHidden

	column 'Order Id'
		dataType: int64
		summarizeBy: none
		sourceColumn: Order Id
		sourceLineageTag: Order Id
		isHidden

	column 'Return Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Return Date
		sourceLineageTag: Return Date
		sourceProviderType: date
		formatString: yyyy-mm-dd
		isHidden

	column RegionKey
		dataType: int64
		summarizeBy: none
		sourceColumn: RegionKey
		sourceLineageTag: RegionKey
		isHidden

	column BusinessUnitKey
		dataType: int64
		summarizeBy: none
		sourceColumn: BusinessUnitKey
		sourceLineageTag: BusinessUnitKey
		isHidden

	column Amount
		dataType: double
		sourceColumn: Amount
		sourceLineageTag: Amount
		formatString: #,##0.00 €
		summarizeBy: sum
		isHidden

	column Reason
		dataType: string
		summarizeBy: none
		sourceColumn: Reason
		sourceLineageTag: Reason

	partition Returns = entity
		mode: directLake
		source
			entityName: FactReturn
			schemaName: cwd
			expressionSource: DatabaseQuery

