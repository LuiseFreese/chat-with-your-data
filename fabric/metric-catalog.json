{
  "metrics": [
    {
      "Id": "gross_revenue",
      "BusinessName": "Gross Revenue",
      "Description": "Order value at list price for all orders that were not cancelled, before discounts, returns and finance corrections. This is the number Sales reports.",
      "Formula": "SUM(order line quantity \u00D7 list price) WHERE OrderStatus \u003C\u003E \u0027Cancelled\u0027",
      "SemanticMeasure": "Gross Revenue",
      "BusinessOwner": "Head of Sales",
      "RelatedMetrics": [
        "net_revenue",
        "total_discounts"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "gross revenue",
        "gross sales",
        "sales revenue",
        "bookings",
        "order value",
        "gross order value"
      ],
      "AmbiguityGroup": "revenue",
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": "Sales calls this \u0027revenue\u0027. Finance never does.",
      "LineGrain": true,
      "IsCurrency": true
    },
    {
      "Id": "total_discounts",
      "BusinessName": "Total Discounts",
      "Description": "Sum of all discounts granted on order lines (volume, contract and campaign discounts).",
      "Formula": "SUM(order line discount amount)",
      "SemanticMeasure": "Total Discounts",
      "BusinessOwner": "Head of Sales",
      "RelatedMetrics": [
        "gross_revenue",
        "net_revenue"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "discounts",
        "total discounts",
        "discount amount",
        "rebates"
      ],
      "AmbiguityGroup": null,
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": null,
      "LineGrain": true,
      "IsCurrency": true
    },
    {
      "Id": "total_returns",
      "BusinessName": "Total Returns",
      "Description": "Value of goods returned by customers, booked as credit notes.",
      "Formula": "SUM(credit note amount)",
      "SemanticMeasure": "Total Returns",
      "BusinessOwner": "Head of Customer Service",
      "RelatedMetrics": [
        "net_revenue"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "returns",
        "total returns",
        "credit notes",
        "refunds"
      ],
      "AmbiguityGroup": null,
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": null,
      "LineGrain": false,
      "IsCurrency": true
    },
    {
      "Id": "net_revenue",
      "BusinessName": "Net Revenue",
      "Description": "Gross Revenue minus discounts and returns. The number Finance reports in the monthly close \u2013 before manual corrections.",
      "Formula": "[Gross Revenue] \u2212 [Total Discounts] \u2212 [Total Returns]",
      "SemanticMeasure": "Net Revenue",
      "BusinessOwner": "Head of Finance",
      "RelatedMetrics": [
        "gross_revenue",
        "adjusted_net_revenue"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "net revenue",
        "net sales",
        "revenue after discounts",
        "invoiced revenue",
        "finance revenue"
      ],
      "AmbiguityGroup": "revenue",
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": "Operational apps often use \u0027net\u0027 to mean \u0027after discounts\u0027 but forget returns.",
      "LineGrain": false,
      "IsCurrency": true
    },
    {
      "Id": "finance_adjustments",
      "BusinessName": "Finance Adjustments",
      "Description": "Approved manual corrections booked by Finance (contract true-ups, pricing errors, bad debt). Historically maintained in an Excel workbook outside the pipeline.",
      "Formula": "SUM(adjustment amount) WHERE Status = \u0027Approved\u0027",
      "SemanticMeasure": "Finance Adjustments",
      "BusinessOwner": "Head of Finance",
      "RelatedMetrics": [
        "adjusted_net_revenue",
        "net_revenue"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "finance adjustments",
        "adjustments",
        "corrections",
        "manual corrections",
        "excel corrections"
      ],
      "AmbiguityGroup": null,
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": null,
      "LineGrain": false,
      "IsCurrency": true
    },
    {
      "Id": "adjusted_net_revenue",
      "BusinessName": "Adjusted Net Revenue",
      "Description": "Net Revenue including approved finance adjustments. The number Management steers the company with.",
      "Formula": "[Net Revenue] \u002B [Finance Adjustments]",
      "SemanticMeasure": "Adjusted Net Revenue",
      "BusinessOwner": "CFO",
      "RelatedMetrics": [
        "net_revenue",
        "finance_adjustments"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "adjusted net revenue",
        "adjusted revenue",
        "management revenue",
        "revenue incl. adjustments",
        "corrected revenue"
      ],
      "AmbiguityGroup": "revenue",
      "FormatString": "#,##0 \u20AC",
      "ConfusionNote": null,
      "LineGrain": false,
      "IsCurrency": true
    },
    {
      "Id": "order_count",
      "BusinessName": "Order Count",
      "Description": "Number of distinct orders that were not cancelled.",
      "Formula": "DISTINCTCOUNT(OrderId) WHERE OrderStatus \u003C\u003E \u0027Cancelled\u0027",
      "SemanticMeasure": "Order Count",
      "BusinessOwner": "Head of Sales",
      "RelatedMetrics": [
        "average_order_value"
      ],
      "ApprovedForConversationalQuerying": true,
      "Synonyms": [
        "orders",
