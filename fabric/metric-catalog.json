      "ConfusionNote": null,
      "LineGrain": false,
      "IsCurrency": true
    },
    {
      "Id": "finance_adjustments_pipeline_only",
      "BusinessName": "Finance Adjustments (pipeline feed only)",
      "Description": "Finance adjustments that reached the pipeline before the Excel workbook was reconciled. Used by the Data Reconciliation screen to show the gap; not offered in chat.",
      "Formula": "SUM(adjustment amount) WHERE Status = \u0027Approved\u0027 AND Source = \u0027Pipeline\u0027",
      "SemanticMeasure": "Finance Adjustments Pipeline Only",
