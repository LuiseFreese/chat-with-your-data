      "AmbiguityGroup": null,
      "FormatString": "#,##0",
      "ConfusionNote": null,
      "LineGrain": true,
      "IsCurrency": false
    },
    {
      "Id": "average_order_value",
      "BusinessName": "Average Order Value",
      "Description": "Net Revenue divided by Order Count.",
      "Formula": "DIVIDE([Net Revenue], [Order Count])",
      "SemanticMeasure": "Average Order Value",
      "BusinessOwner": "Head of Sales",
