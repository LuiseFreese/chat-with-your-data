{
  "//": "Template for src/Northstar.Web/appsettings.json (Connected Mode). Copy the values you need; keep secrets in 'dotnet user-secrets'. Local Demo Mode works without any of this.",
  "Demo": {
    "Mode": "Connected",
    "IntentParser": "AzureOpenAI",
    "DataSeed": 20260325
  },
  "Fabric": {
    "WorkspaceId": "<your-fabric-workspace-id>",
    "GovernedSemanticModelId": "<id printed by: dotnet run --project tools/Northstar.Fabric.Tool -- deploy-model>",
    "GovernedSemanticModelName": "CWD-GovernedModel",
    "PowerBiApiBaseUrl": "https://api.powerbi.com/v1.0/myorg/",
    "Scopes": [ "https://analysis.windows.net/powerbi/api/Dataset.Read.All" ]
  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-azure-openai-resource>.cognitiveservices.azure.com/",
    "Deployment": "<your-chat-model-deployment-name>",
    "ApiKey": "",
    "TimeoutSeconds": 20
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-app-registration-client-id>",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  }
}
